@OBSThemeMeta {
    name: 'Red';
    id: 'com.obsproject.midnight.red';
    extends: 'com.obsproject.midnight';
    author: 'Alexey Frolov';
    dark: 'true';
}

@OBSThemeVars {
    /* OBS Color Palette */
    --primary: var(--red3);
    --primary_light: var(--red2);
    --primary_lighter: var(--red1);
    --primary_dark: var(--red4);
    --primary_darker: var(--red5);
    --primary_darkest: var(--red6);
}
